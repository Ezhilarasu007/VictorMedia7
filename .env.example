# VictorMedia Environment Variables Configuration
# Domain: victormedia.net

# Supabase Credentials (Public client-side safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Private Admin Key (SERVER SIDE ONLY - NEVER EXPOSE TO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Server-Side AI Provider Key (SERVER SIDE ONLY)
AI_PROVIDER_API_KEY=your-openai-or-anthropic-api-key-here

# Google Analytics & AdSense Metadata (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_PUB_ID=pub-XXXXXXXXXXXXXXXX
